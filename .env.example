# Copiá este archivo a .env y completá los valores. Nunca commitees .env.
# Detalle de cada variable: docs/03-arquitectura.md §9.

# Base de datos (F00)
MONGODB_URI=

# Auth (F01)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL=

# Fotos de comprobantes en R2 (F08)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# IA (F09)
ANTHROPIC_API_KEY=
AI_MODEL_TICKET=
AI_MODEL_PLAN=

# Push (F07)
VAPID_PUBLIC_KEY=
